Plecs {
  Name          "IHCooker_PowerStage"
  Version       "4.9"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "5e-3"
  Timeout       ""
  Solver        "auto"
  MaxStep       "2e-8"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "1"
  ZCStepSize    "1e-9"
  RelTol        "1e-4"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "3"
  NegativeSwitchLossMsg "3"
  DivisionByZeroMsg "3"
  DatatypeOverflowMsg "3"
  DatatypeInheritanceConflictMsg "2"
  ContSampleTimeConflictMsg "2"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "3"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "% --- Given specs ---\nVdc     = 200;          % DC "
"input (V)\nP_full  = 1e3;          % full power (W)\nf_full  = 27e3;         "
"% switching frequency at full power (Hz)\n\n% --- Design choices (assumptions"
") ---\nphi     = 30*pi/180;    % tank phase angle at full power (rad)\nL_eq  "
"  = 60e-6;        % coil + pan inductance (H)\n\n% --- Derived tank values --"
"-\nV1      = 2*Vdc/pi;                         % half-bridge fundamental ampl"
"itude (V pk) / inverter fundamental voltage\nR_eq    = V1^2*cos(phi)^2/(2*P_f"
"ull);       % ohm\nw       = 2*pi*f_full;\nX       = R_eq*tan(phi);          "
"          % tank reactance at f_full (ohm)\nC_r     = 1/(w*(w*L_eq - X));    "
"           % resonant capacitor (F)\nf0      = 1/(2*pi*sqrt(L_eq*C_r));      "
"    % resonant frequency (Hz)\n\n% --- Half-power frequency (R_eq held consta"
"nt) ---\nphi_h   = acos(sqrt(0.5)*cos(phi));\nX_h     = R_eq*tan(phi_h);\nw_h"
"     = (X_h*C_r + sqrt((X_h*C_r)^2 + 4*L_eq*C_r))/(2*L_eq*C_r);\nf_half  = w_"
"h/(2*pi);\n\n% --- Run selection: set f_sw to f_full or f_half ---\nf_sw    ="
" f_half;\nt_dead  = 500e-9;                % placeholder, to be set after dev"
"ice selection\nD       = 0.5 - f_sw*t_dead;     % gate duty cycle\nt_delay = "
"1/(2*f_sw);            % Q2 phase delay (s)\n\n% --- Displaying Calculated Ph"
"ase Angle --- \nX_sw   = 2*pi*f_sw*L_eq - 1/(2*pi*f_sw*C_r);   % tank reactan"
"ce at f_sw (ohm)\nphi_sw = atan(X_sw/R_eq)*180/pi;                 % phase la"
"g (deg)\n\n% --- Input capacitor stage ---\nL_src  = 100e-6;     % source lea"
"d inductance (H), blocks ripple\nC_in   = 63.9e-6;    % input capacitor (F), "
"from the 2 V p-p target at full power\nP_sw   = V1^2*cos(atan(X_sw/R_eq))^2/("
"2*R_eq);   % fundamental-only power at f_sw (W)\nI_dc0  = P_sw/Vdc;          "
"                     % expected average source current (A)\nR_damp = 2;\n\n% "
"--- Placeholders for Stage 2 ---\nC_oss   = 200e-12;               % per swit"
"ch, placeholder"
  InitialState  "1"
  SystemState   ""
  TaskingMode   "1"
  TaskConfigurations ""
  CodeGenParameterInlining "2"
  CodeGenFloatingPointFormat "2"
  CodeGenAbsTimeUsageMsg "3"
  CodeGenBaseName ""
  CodeGenOutputDir ""
  CodeGenExtraOpts ""
  CodeGenTarget "Generic"
  CodeGenTargetSettings ""
  ExtendedMatrixPrecision "1"
  MatrixSignificanceCheck "2"
