Plecs {
  Name          "IHCooker_Control-Sensing-PS"
  Version       "4.9"
  CircuitModel  "ContStateSpace"
  StartTime     "0.0"
  TimeSpan      "100e-3"
  Timeout       ""
  Solver        "auto"
  MaxStep       "30e-3"
  InitStep      "-1"
  FixedStep     "1e-3"
  Refine        "1"
  ZCStepSize    "1e-9"
  RelTol        "1e-4"
  AbsTol        "-1"
  TurnOnThreshold "0"
  NonIdealSwitchResistance "1"
  SyncFixedStepTasks "2"
  UseSingleCommonBaseRate "2"
  LossVariableLimitExceededMsg "3"
  NegativeSwitchLossMsg "3"
  DivisionByZeroMsg "3"
  DatatypeOverflowMsg "3"
  DatatypeInheritanceConflictMsg "2"
  ContSampleTimeConflictMsg "2"
  StiffnessDetectionMsg "2"
  MaxConsecutiveZCs "1000"
  AlgebraicLoopWithStateMachineMsg "3"
  AssertionAction "1"
  FixedPointDatatypeOverride "1"
  InitializationCommands "% --- Given specs ---\nVdc     = 200;          % DC "
"input (V)\nP_full  = 1e3;          % full power (W)\nf_full  = 27e3;         "
"% switching frequency at full power (Hz)\n\n% --- Design choices (assumptions"
") ---\nphi     = 30*pi/180;    % tank phase angle at full power (rad)\nL_eq  "
"  = 60e-6;        % coil + pan inductance (H) (60 uF is pre-coil design)\n\n%"
" --- Derived tank values ---\nV1      = 2*Vdc/pi;                         % h"
"alf-bridge fundamental amplitude (V pk) / inverter fundamental voltage\n% R_e"
"q    = 5.58921;\n R_eq    = V1^2*cos(phi)^2/(2*P_full);       % ohm\nw       "
"= 2*pi*f_full;\nX       = R_eq*tan(phi);                    % tank reactance "
"at f_full (ohm)\nC_r = 0.33e-6 + 0.33e-6 + 0.22e-6;\nf0      = 1/(2*pi*sqrt(L"
"_eq*C_r));          % resonant frequency (Hz)\nC_r_design = 1/(w*(w*L_eq - X)"
");            % resonant capacitor (F)\n\n% --- Half-power frequency (R_eq he"
"ld constant) ---\nphi_h   = acos(sqrt(0.5)*cos(phi));\nX_h     = R_eq*tan(phi"
"_h);\nw_h     = (X_h*C_r + sqrt((X_h*C_r)^2 + 4*L_eq*C_r))/(2*L_eq*C_r);\nf_h"
"alf  = w_h/(2*pi);\n\n% --- Run selection: set f_sw to f_full or f_half ---\n"
"f_sw    = f_full;\nt_dead  = 500e-9;                % placeholder, to be set "
"after device selection\nD       = 0.5 - f_sw*t_dead;     % gate duty cycle\nt"
"_delay = 1/(2*f_sw);            % Q2 phase delay (s)\n\n% --- Displaying Calc"
"ulated Phase Angle --- \nX_sw   = 2*pi*f_sw*L_eq - 1/(2*pi*f_sw*C_r);   % tan"
"k reactance at f_sw (ohm)\nphi_sw = atan(X_sw/R_eq)*180/pi;                 %"
" phase lag (deg)\n\n% --- Input capacitor stage ---\nL_src  = 100e-6;     % s"
"ource lead inductance (H), blocks ripple\n\ntolCin  = 0;                     "
" % +-0.05 for corner runs\nC_in    = 100e-6*(1+tolCin);      % input capacito"
"r (F), from the 2 V p-p target at full power: KEMET C4AQIEW6100A3BJ\nESR_Cin "
"= 2.2e-3;                 % KEMET datasheet, 70 C, 10 kHz\n\nP_sw   = V1^2*co"
"s(atan(X_sw/R_eq))^2/(2*R_eq);   % fundamental-only power at f_sw (W)\nI_dc0 "
" = P_sw/Vdc;                               % expected average source current "
"(A)\nR_damp = 2;\n\n% --- Cr: 2 x 940C6P33K-F + 1 x 940C6P22K-F (Cornell Dubi"
"lier, PP film, 600 V, +-10%) ---\ntolC    = 0;                       % 0 = no"
"minal; use -0.03 / +0.03 for corner runs\nCr1 = 0.33e-6*(1+tolC);            "
"% 940C6P33K-F\nCr2 = 0.33e-6*(1+tolC);            % 940C6P33K-F\nCr3 = 0.22e-"
"6*(1+tolC);            % 940C6P22K-F\nESR_Cr1 = 9e-3;\nESR_Cr2 = 9e-3;\nESR_C"
"r3 = 12e-3;\n\n% --- Placeholders for Stage 2 ---\nC_oss1   = 387.3e-12;     "
"          % per switch, placeholder\nC_oss2   = 387.3e-12;"
  InitialState  "1"
  SystemState   ""
  TaskingMode   "1"
  TaskConfigurations ""
  CodeGenParameterInlining "2"
  CodeGenFloatingPointFormat "2"
  CodeGenAbsTimeUsageMsg "3"
  CodeGenBaseName ""
  CodeGenOutputDir ""
